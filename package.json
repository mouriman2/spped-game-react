{
  "name": "react-typescript-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A modern React TypeScript template with ESLint, Jest, and Tailwind CSS",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
